#!/bin/sh
#MISE description="Test the Zettide volume"
#MISE depends=["build:spdk"]
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
cd "$root/zettide"
zig build test --summary all
PKG_CONFIG_PATH="$root/third_party/spdk/build/lib/pkgconfig" \
  zig build test-spdk-link --summary all
